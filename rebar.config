{minimum_otp_vsn, "22"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_vars,
    nowarn_unused_function
]}.

{deps, []}.

{project_plugins, []}.

%% Profiles
{profiles, [
    {test, [
        {erl_opts, [debug_info]}
    ]}
]}.

%% Dialyzer
{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        underspecs
    ]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, []}
]}.

%% XRef
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
